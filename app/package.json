{
  "name": "timon-app",
  "version": "0.1.7",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-locales.mjs --pseudo",
    "dev": "tsx src/server.ts",
    "prebuild": "node scripts/build-locales.mjs",
    "build": "next build && node scripts/build-server.mjs",
    "start": "tsx --require ./scripts/production-env.cjs src/server.ts",
    "pretypecheck": "node scripts/build-locales.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-locales.mjs",
    "test": "node ../scripts/run-tests.mjs",
    "worker:telegram": "tsx src/workers/telegram-poll.ts",
    "worker:reply": "tsx src/workers/mission-watcher.ts"
  },
  "timonTests": {
    "imports": [
      "tsx",
      "../scripts/test-tmp-preload.mjs"
    ],
    "files": [
      "src/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "highlight.js": "^11.11.1",
    "intl-messageformat": "^12.1.4",
    "isomorphic-dompurify": "^3.13.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.3",
    "next": "^14.2.15",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "three": "^0.185.1",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2"
